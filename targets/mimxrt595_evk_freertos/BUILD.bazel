load("@rules_python//sphinxdocs:sphinx_docs_library.bzl", "sphinx_docs_library")
load("//pw_build:compatibility.bzl", "incompatible_with_mcu")
load("//pw_build:merge_flags.bzl", "flags_from_dict")
load("//pw_build:pw_linker_script.bzl", "pw_linker_script")
load("//third_party/freertos:flags.bzl", "FREERTOS_FLAGS")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

constraint_value(
    name = "freertos_config_cv",
    constraint_setting = "@freertos//:freertos_config_setting",
)

platform(
    name = "platform",
    constraint_values = [
        ":freertos_config_cv",
        "//pw_build/constraints/rtos:freertos",
        "//pw_interrupt_cortex_m:backend",
        "//pw_build/constraints/board:mimxrt595_evk",
        "//pw_malloc_freertos:backend",
        "//pw_build/constraints/arm:cortex-m33",
        "@freertos//:port_ARM_CM33_NTZ",
        "@freertos//:malloc_heap_4",
        "@freertos//:disable_task_statics",
        "@platforms//cpu:armv8-m",
        "@platforms//os:linux",
        "@rust_crates//:no_std",
        "@mcuxpresso//:middleware.freertos-kernel.MIMXRT595S",
    ],
    flags = flags_from_dict(FREERTOS_FLAGS | {
        "@freertos//:freertos_config": "//targets/mimxrt595_evk_freertos:freertos_config",
        "@pigweed//pw_assert:assert_backend": "//pw_assert_basic",
        "@pigweed//pw_assert:assert_backend_impl": "//pw_assert_basic:impl",
        "@pigweed//pw_assert:check_backend": "//pw_assert_basic",
        "@pigweed//pw_assert:check_backend_impl": "//pw_assert_basic:impl",
        "@pigweed//pw_boot:backend": "//pw_boot_cortex_m:armv8m",
        "@pigweed//pw_log:backend": "//pw_log_basic",
        "@pigweed//pw_log:backend_impl": "//pw_log_basic:impl",
        "@pigweed//pw_malloc:backend": "//pw_malloc:bucket_block_allocator",
        "@pigweed//pw_sys_io:backend": "//pw_sys_io_mcuxpresso",
        "@pigweed//pw_system:extra_platform_libs": "//targets/mimxrt595_evk_freertos:extra_platform_libs",
        "@pigweed//pw_unit_test:main": "//targets/mimxrt595_evk_freertos:unit_test_app",
        "//targets:mcuxpresso_sdk": "//targets/mimxrt595_evk_freertos:mcuxpresso_sdk",
        "@mcuxpresso//:user_config": "//targets/mimxrt595_evk_freertos/config",
        "@mcuxpresso//:user_defines": "//targets/mimxrt595_evk_freertos:mcuxpresso_sdk_componenets_defines",
        "@mcuxpresso//:app_include": "//targets/mimxrt595_evk_freertos/config:app_bluetooth_config.h",
    }),
)


cc_library(
    name = "mcuxpresso_sdk",
    target_compatible_with = [
        "//pw_build/constraints/board:mimxrt595_evk",
        "//pw_build/constraints/rtos:freertos",
        "@platforms//cpu:armv8-m",
    ],
    deps = [
        ":mcuxpresso_sdk_components",
        "//targets/mimxrt595_evk_freertos/config",
        "@mcuxpresso//:user_config",
    ],
)


cc_library(
    name = "mcuxpresso_sdk_components",
    target_compatible_with = [
        "//pw_build/constraints/board:mimxrt595_evk",
        "//pw_build/constraints/rtos:freertos",
        "@platforms//cpu:armv8-m",
    ],
    deps = [
        "@mcuxpresso//:component.serial_manager.MIMXRT595S",
        "@mcuxpresso//:component.serial_manager_uart.MIMXRT595S",
        "@mcuxpresso//:component.audio_flexcomm_i2s_dma_adapter.MIMXRT595S",
        "@mcuxpresso//:driver.wm8904.MIMXRT595S",
        "@mcuxpresso//:driver.codec.MIMXRT595S",
        "@mcuxpresso//:platform.drivers.flexcomm_i2c.MIMXRT595S",
        "@mcuxpresso//:platform.drivers.flexcomm_spi.MIMXRT595S",
        "@mcuxpresso//:platform.drivers.flexcomm_usart_dma.MIMXRT595S",
        "@mcuxpresso//:platform.drivers.flexcomm_usart_freertos.MIMXRT595S",
        "@mcuxpresso//:platform.drivers.flexio_spi.MIMXRT595S",
        "@mcuxpresso//:platform.drivers.inputmux.MIMXRT595S",
        "@mcuxpresso//:platform.drivers.lpc_dma.MIMXRT595S",
        "@mcuxpresso//:platform.drivers.lpc_gpio.MIMXRT595S",
        "@mcuxpresso//:platform.drivers.lpc_iopctl.MIMXRT595S",
        "@mcuxpresso//:platform.drivers.flexspi.MIMXRT595S",
        "@mcuxpresso//:platform.drivers.mu.MIMXRT595S",
        "@mcuxpresso//:platform.drivers.pint.MIMXRT595S",
        "@mcuxpresso//:platform.drivers.power.MIMXRT595S",
        "@mcuxpresso//:platform.drivers.cache_cache64.MIMXRT595S",
        "@mcuxpresso//:platform.drivers.flash_config.evkmimxrt595.MIMXRT595S",
        "@mcuxpresso//:platform.drivers.i3c.MIMXRT595S",
        "@mcuxpresso//:utility.debug_console.MIMXRT595S",
        "@mcuxpresso//:device.MIMXRT595S_CMSIS.MIMXRT595S",
        "@mcuxpresso//:middleware.wifi.fwdnld_intf_abs.MIMXRT595S",
        "@mcuxpresso//:middleware.edgefast_bluetooth.wifi_nxp.controller.base.MIMXRT595S",
        "@mcuxpresso//:middleware.edgefast_bluetooth.btble.ethermind.cm33.MIMXRT595S",
        "@mcuxpresso//:middleware.usb.device_controller_ip3511hs.MIMXRT595S",
        "@mcuxpresso//:middleware.usb.phy.MIMXRT595S",
        "@mcuxpresso//:middleware.usb.device.controller.driver.MIMXRT595S",
        "@mcuxpresso//:middleware.usb.device.ip3511hs_config_header.MIMXRT595S",
        "@mcuxpresso//:middleware.usb.device.common_header.MIMXRT595S",
        "@mcuxpresso//:middleware.usb.common_header.MIMXRT595S",
        "@mcuxpresso//:component.mflash.rt595.MIMXRT595S",
        "@mcuxpresso//:component.i3c_adapter.MIMXRT595S",
        "@mcuxpresso//:middleware.edgefast_bluetooth.common.ethermind.MIMXRT595S",
        "@mcuxpresso//:middleware.edgefast_bluetooth.btble.ethermind.lib.cm33.MIMXRT595S",
    ],
    linkopts = [
        "-Wl,--whole-archive",
        "$(execpath @mcuxpresso//:middleware.edgefast_bluetooth.btble.ethermind.lib.cm33.MIMXRT595S)",
        "-Wl,--no-whole-archive",
    ],
)

cc_library(
    name = "mcuxpresso_sdk_componenets_defines",
    hdrs = [
        "//targets/mimxrt595_evk_freertos/config:wifi_config.h",
    ],
    includes = [ "config" ],
    defines = [
        "BOOT_HEADER_ENABLE=1",
        "CPU_MIMXRT595SFFOC_cm33",
        "DEBUG_CONSOLE_TRANSFER_NON_BLOCKING=1",
        "SDK_OS_FREE_RTOS",
        "SDK_I2C_BASED_COMPONENT_USED=1",
        "SDK_I3C_BASED_COMPONENT_USED=1",
        "BOARD_USE_CODEC=1",
        "WIFI_BT_TX_PWR_LIMITS=wlan_txpwrlimit_cfg_murata_1XK_WW.h",
        "SD8978",
        "SDMMCHOST_OPERATION_VOLTAGE_1V8",
        "SD_TIMING_MAX=kSD_TimingDDR50Mode",
        "WIFI_BT_USE_M2_INTERFACE",
        "WLAN_ED_MAC_CTRL=\"{.ed_ctrl_2g = 0x1, .ed_offset_2g = 0x0, .ed_ctrl_5g = 0x1, .ed_offset_5g = 0x6}\"",
        "FSL_RTOS_FREE_RTOS",
        "FSL_OSA_BM_TASK_ENABLE=0",
        "FSL_OSA_BM_TIMER_CONFIG=0",
        "USB_STACK_USE_DEDICATED_RAM=1",
    ],
    target_compatible_with = [
        "//pw_build/constraints/board:mimxrt595_evk",
        "//pw_build/constraints/rtos:freertos",
        "@platforms//cpu:armv8-m",
    ],
    deps = [
        ":freertos_config",
        "@freertos",
    ],
)

exports_files(["mimxrt595_flash.ld"])

cc_library(
    name = "flash_linker_script_defines",
    defines = [
        "PW_BOOT_FLASH_BEGIN=0x08001180",
        "PW_BOOT_FLASH_SIZE=0x001FEE80",
        "PW_BOOT_HEAP_SIZE=200K",
        "PW_BOOT_MIN_STACK_SIZE=1K",
        "PW_BOOT_RAM_BEGIN=0x20080000",
        "PW_BOOT_RAM_SIZE=0x00280000",
        "PW_BOOT_VECTOR_TABLE_BEGIN=0x08001000",
        "PW_BOOT_VECTOR_TABLE_SIZE=0x00000180",
    ],
)

pw_linker_script(
    name = "flash_linker_script",
    linker_script = ":mimxrt595_flash.ld",
    target_compatible_with = [
        "//pw_build/constraints/board:mimxrt595_evk",
        "//pw_build/constraints/rtos:freertos",
        "@platforms//cpu:armv8-m",
    ],
    deps = [
        ":flash_linker_script_defines",
    ],
)

cc_library(
    name = "unit_test_app",
    testonly = True,
    srcs = [
        "unit_test_app.cc",
    ],
    target_compatible_with = [
        "//pw_build/constraints/board:mimxrt595_evk",
        "//pw_build/constraints/rtos:freertos",
        "@platforms//cpu:armv8-m",
    ],
    deps = [
        "//pw_status",
        "//pw_system",
        "//pw_unit_test",
        "//pw_unit_test:logging_event_handler",
    ],
    alwayslink = 1,
)

cc_library(
    name = "boot",
    srcs = [
        "boot.cc",
        "vector_table.c",
    ],
    defines = [
        "PW_MALLOC_ACTIVE=1",
    ],
    target_compatible_with = [
        "//pw_build/constraints/board:mimxrt595_evk",
        "//pw_build/constraints/rtos:freertos",
        "@platforms//cpu:armv8-m",
    ],
    deps = [
        "//pw_boot",
        "//pw_boot_cortex_m",
        "//pw_malloc",
        "//pw_preprocessor",
        "//pw_sys_io_mcuxpresso",
        "//pw_system:init",
        "//targets:mcuxpresso_sdk",
        "//third_party/freertos:support",
    ],
    alwayslink = 1,
)

cc_library(
    name = "freertos_config",
    hdrs = [
        "config_freertos/FreeRTOSConfig.h",
    ],
    strip_include_prefix = "config_freertos",
    target_compatible_with = [
        "//pw_build/constraints/board:mimxrt595_evk",
        "//pw_build/constraints/rtos:freertos",
        "@platforms//cpu:armv8-m",
    ],
    deps = ["//third_party/freertos:config_assert"],
)

cc_library(
    name = "extra_platform_libs",
    target_compatible_with = [
        "//pw_build/constraints/board:mimxrt595_evk",
        "//pw_build/constraints/rtos:freertos",
        "@platforms//cpu:armv8-m",
    ],
    deps = [
        ":boot",
        ":flash_linker_script",
        "//pw_tokenizer:linker_script",
        "//pw_toolchain/arm_gcc:arm_none_eabi_gcc_support",
    ],
)

sphinx_docs_library(
    name = "docs",
    srcs = [
        "target_docs.rst",
    ],
    target_compatible_with = incompatible_with_mcu(),
)
