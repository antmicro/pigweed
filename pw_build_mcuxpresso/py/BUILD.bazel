        "component.i3c_adapter.MIMXRT595S",
        "component.osa.MIMXRT595S",
        "--exclude",
        "device.MIMXRT595S_startup.MIMXRT595S",
        "middleware.sdmmc.sdhc.template.MIMXRT595S",
