load("@rules_python//sphinxdocs:sphinx_docs_library.bzl", "sphinx_docs_library")
load("//pw_build:compatibility.bzl", "incompatible_with_mcu")
load("//pw_unit_test:pw_cc_test.bzl", "pw_cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "bluetooth_sapphire_mcuxpresso",
    srcs = [
        "controller.cc",
    ],
    hdrs = [
        "public/pw_bluetooth_sapphire_mcuxpresso/controller.h",
    ],
    includes = [
        "public",
    ],
    deps = [
        "@pigweed//pw_containers:vector",
        "@pigweed//pw_containers:inline_queue",
        "@pigweed//pw_thread:thread",
        "@pigweed//pw_sync:interrupt_spin_lock",
        "@pigweed//pw_sync:thread_notification",
        "@pigweed//pw_bluetooth:pw_bluetooth",
        "@pigweed//pw_bluetooth_sapphire/host:stack",
        "@pigweed//targets:mcuxpresso_sdk",
    ],
)

pw_cc_test(
    name = "controller_example",
    srcs = ["example.cc"],
    target_compatible_with = [
        "//pw_build/constraints/board:mimxrt595_evk",
    ],
    deps = [
        ":bluetooth_sapphire_mcuxpresso",
        "//pw_chrono:wrap_time_system_clock",
        "//pw_async_basic:dispatcher",
    ],
    copts = [
        "-Wno-shadow",
        "-Wno-changes-meaning",
        "-Wno-error",
    ]
)

filegroup(
    name = "doxygen",
    srcs = [
        "public/pw_bluetooth_sapphire_mcuxpresso/controller.h",
    ],
)

sphinx_docs_library(
    name = "docs",
    srcs = [
        "docs.rst",
        "example.cc",
    ],
    prefix = "pw_bluetooth_sapphire_mcuxpresso/",
    target_compatible_with = incompatible_with_mcu(),
    visibility = ["//visibility:public"],
)
