package(default_visibility = ["//visibility:public"])

cc_library(
    name = "aosp_polyfill",
    hdrs = [
        "public/android-base/mapped_file.h",
        "public/android-base/stringprintf.h",
    ],
    includes = ["public/"],
    deps = [
        "@pigweed//pw_assert",
        # pw_bluetooth_sapphire has the AOSP-style std::string printf utilities
        # in an internal library along with tests; use it instead of rolling our
        # own variant.
        "@pigweed//pw_bluetooth_sapphire/lib/cpp-string",
    ],
)

cc_library(
    name = "libsparse_wrap_unsupported",
    srcs = [
        "wrap.cc",
    ],
    linkopts = [
        "-Wl,--wrap=sparse_file_add_file",
        "-Wl,--wrap=sparse_file_add_fd",
        "-Wl,--wrap=sparse_file_write",
        "-Wl,--wrap=sparse_file_read",
        "-Wl,--wrap=sparse_file_import",
        "-Wl,--wrap=sparse_file_import_auto",
        "-Wl,--wrap=open",
        "-Wl,--wrap=close",
    ],
    deps = [
        "@pigweed//pw_assert",
    ],
)

# Default configuration for libsparse, optimized for MCUs with low memory.
cc_library(
    name = "libsparse_default_config",
    defines = [
        'PW_LIBSPARSE_FILL_BUF_SIZE="(4096)"',
        'PW_LIBSPARSE_COPY_BUF_SIZE="(4096)"',
    ],
)

label_flag(
    name = "libsparse_config_override",
    build_setting_default = ":libsparse_default_config",
)

# ``@aosp-core`` is injected with a custom build file, as it is not available in
# BCR. This alias exposes the cc_library to Pigweed dependents without requiring
# them to duplicate the git_override in their MODULE.bazel.
alias(
    name = "libsparse",
    actual = "@aosp-core//:sparse",
)
